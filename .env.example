# Copy to .env.local. Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Skips RLS; used only to store processed photos.
SUPABASE_SECRET_KEY=
# Optional until approved. Without it, photo moderation is a stub that holds nothing.
OPENAI_API_KEY=
